.env
__pycache__/
*.pyc
certs/

# Data files (too large / generated / sensitive)
data/odds_cache.json
data/odds_cache_*.json
data/oddspapi_cache*.json
data/api_quota.json
data/*.db
data/*.bz2
*.xlsx
*.xlsm
*.csv
*.zip
# Pre-ingest / pre-rebuild snapshots. The daily ingest job writes one per
# league per run, so these accumulate; they are data, never source.
# The trailing wildcard is load-bearing: the job stamps a run tag *after*
# the extension (foo.csv.bak-20260821-085148-preseason26), so a bare *.bak
# matches none of the files this rule exists to ignore.
*.bak*

# Holding folder used during git surgery (Option β-tight PR split)
tmp_session_holding/

# Reports — kept local, not part of source
reports/

# Test fixtures are source, not data. They must survive the blanket format
# ignores above (*.csv especially) or regression tests silently stop running
# on a clean checkout — the failure mode is a green suite that proves nothing.
!tests/fixtures/**

# Historical odds-data archives (hundreds of thousands of files, GBs of data —
# checked into local working copies but not source-controlled)
BTTS_data/
BetFairData_OU/
data/championship_raw/
data/pl_raw/
data/fpl_historical/
data/player_data/

# Other local-only data files
data/understat_*.csv
data/weather_cache.csv

# Notebooks
*.ipynb

# PDFs and docs
*.pdf
*.odt

# Logs
logs/

# IDE / editor
# Claude Code: track project-local agents, commands, and skills only.
# Everything else under .claude/ (worktrees, all settings, locks, runtime
# state) stays local — settings may hold machine-specific paths/permissions.
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/skills/
.claude/agents/*.json
.vscode/
*.swp

# Generated models
models/

# Checkpoints
Checkpoints for Test/

# Misc
codebase/
Dixon Coles Paper/
New Project Data/
